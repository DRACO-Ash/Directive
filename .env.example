# Every runtime variable, by name, with a placeholder. Never a real value.
# Copy to .env for local work. .env is git-ignored and never committed.
#
# On the Bluestaq App Store these are set in the operator console, not in this file.
# PORT and STORAGE_MOUNT_PATH are injected by the platform: never type either into the
# console environment tab, because anything typed there overrides the injected value.

# Microsoft Entra ID application registration
TENANT_ID=[REDACTED:guid]
CLIENT_ID=[REDACTED:guid]
CLIENT_SECRET=[REDACTED:secret]
REDIRECT_URI=https://comply-ops.apps.bluestaq.com/auth/callback

# Flask server-side session signing key
SESSION_KEY=[REDACTED:secret]

# SharePoint site holding the compliance lists
SHAREPOINT_SITE_ID=[REDACTED:site-id]

# Audit signing. Without AUDIT_HMAC_KEY no audit entry can be written: the chain fails
# closed rather than writing an unsigned entry, because an unkeyed chain can be
# re-stamped by anyone who can edit the SharePoint list. At least 32 characters.
AUDIT_HMAC_KEY=[REDACTED:secret]
AUDIT_KEY_ID=k1
# Empty until the first rotation, then id:key pairs separated by semicolons so entries
# signed before the rotation stay verifiable.
AUDIT_RETIRED_KEYS=

# Build provenance, surfaced by /api/diagnostics
BUILD_ID=local

# Open question in the flight plan. Left off by default on the data-minimisation
# reading of UK GDPR Article 5(1)(c). TBC, re-verify with the ISM.
LOG_VIEW_EVENTS=false
